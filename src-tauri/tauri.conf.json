{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cockpit",
  "version": "2.8.0",
  "identifier": "com.cockpit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cockpit",
        "width": 1280,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Centre de pilotage personnel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyQjI0NEE0NEU3MTM3QTAKUldTZ04zRk9wRVN5TW9TSEZFTXJ2S1dPbEIrdE1qdFVxMWdiVWxEWWVhNy83cGx6Y0RXdlRCR3AK",
      "endpoints": [
        "https://github.com/Raphi72/cockpit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
